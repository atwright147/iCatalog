# Example for a rootless Podman service on an x86-64 VM.
# Copy beside compose.yml as .env, then replace the paths, IP address and IDs.
# The catalogue directory must exist and be writable by the account running Compose.
# The media directory must exist and be readable by that account.
ICATALOG_IMAGE=icatalog:local
ICATALOG_CATALOGUE_DIR=/home/YOUR_USER/icatalog-data
ICATALOG_MEDIA_DIR=/srv/photos
ICATALOG_BIND=192.168.1.20
ICATALOG_PORT=8080
ICATALOG_UID=1000
ICATALOG_GID=1000
ICATALOG_USERNS_MODE=keep-id
ICATALOG_CATALOGUE_FILE=Library.icatalog
