prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")

prefix_rule(pattern=["task", "check"], decision="allow")
prefix_rule(pattern=["task", "ci"], decision="allow")
prefix_rule(pattern=["task", "lint"], decision="allow")
prefix_rule(pattern=["task", "test"], decision="allow")
prefix_rule(pattern=["task", "test:sync"], decision="allow")
prefix_rule(pattern=["task", "test:scale"], decision="allow")
prefix_rule(pattern=["task", "ui:smoke"], decision="allow")
prefix_rule(pattern=["task", "ui:test"], decision="allow")
prefix_rule(pattern=["task", "ui:visual"], decision="allow")
prefix_rule(pattern=["task", "ui:visual:update"], decision="allow")
